# Tencent COS backup settings for /opt/qq-social-agent/scripts/cos_backup.sh
# Copy to /etc/qq-social-agent/cos-backup.env and chmod 600.
COS_BACKUP_DEST=cos://your-bucket-1250000000/qq-social-agent

COS_LOCAL_SNAPSHOT_KEEP_DAYS=14
COSCLI_TIMEOUT_SECONDS=900
COSCLI_NTQQ_TIMEOUT_SECONDS=7200
COSCLI_ERR_RETRY_NUM=2
COSCLI_ROUTINES=2

# Safe daily default: backup NapCat config only. The monthly cron overrides this to 1 once per month.
COS_INCLUDE_NAPCAT_CONFIG=1
COS_INCLUDE_NAPCAT_NTQQ=0
